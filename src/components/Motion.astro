---
import { ClientRouter } from "astro:transitions";
import "lenis/dist/lenis.css";
---
<ClientRouter fallback="animate" />
<script>
  import Lenis from "lenis";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  let lenis: Lenis | undefined; let ticker: ((t:number)=>void) | undefined; let ctx: gsap.Context | undefined;
  const mq = matchMedia("(prefers-reduced-motion: reduce)");
  function clean(){ctx?.revert();ScrollTrigger.getAll().forEach(t=>t.kill());if(ticker)gsap.ticker.remove(ticker);lenis?.destroy();}
  function init(){clean();if(mq.matches)return;lenis=new Lenis({lerp:.085,wheelMultiplier:.88,smoothWheel:true,anchors:{offset:-72}});lenis.on("scroll",ScrollTrigger.update);ticker=(t)=>lenis?.raf(t*1000);gsap.ticker.add(ticker);gsap.ticker.lagSmoothing(0);
    ctx=gsap.context(()=>{
      gsap.from("[data-hero-line]",{yPercent:115,duration:1.2,stagger:.1,ease:"power4.out",delay:.08});
      gsap.from(".hero-card",{scale:.82,rotate:7,autoAlpha:0,duration:1.2,ease:"expo.out",delay:.4});
      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach(el=>{if(el.closest('[hidden]'))return;gsap.from(el,{y:44,autoAlpha:0,duration:.9,ease:"power3.out",scrollTrigger:{trigger:el,start:"top 88%",once:true}})});
      gsap.utils.toArray<HTMLElement>("[data-stagger]").forEach(group=>{if(group.closest('[hidden]'))return;gsap.from(group.children,{y:34,autoAlpha:0,duration:.75,stagger:.1,ease:"power3.out",scrollTrigger:{trigger:group,start:"top 84%",once:true}})});
      gsap.utils.toArray<HTMLElement>("[data-marquee]").forEach(el=>gsap.to(el,{xPercent:-18,ease:"none",scrollTrigger:{trigger:el,start:"top bottom",end:"bottom top",scrub:1}}));
    }); requestAnimationFrame(()=>ScrollTrigger.refresh());
  }
  document.addEventListener("astro:page-load",init);document.addEventListener("astro:before-swap",clean);mq.addEventListener("change",init);
</script>
