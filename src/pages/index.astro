---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import "../styles/landing.css";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Clainev — Software útil para negocios reales" description="Facturación electrónica con Emitiva, revisión de contratos con Firma Segura y software a medida para negocios en Perú.">
  <main class="fl-page">
    <section class="fl-hero" aria-labelledby="fl-title">
      <div class="fl-spark fl-spark-blue" aria-hidden="true"></div>
      <div class="fl-spark fl-spark-orange" aria-hidden="true"></div>
      <div class="fl-hero-mark" aria-hidden="true"><span>C</span><span>E</span><span>F</span><span>+</span></div>
      <p class="fl-kicker">ESTUDIO DE SOFTWARE · PERÚ</p>
      <h1 id="fl-title">Software para lo que <strong>sí importa.</strong></h1>
      <p class="fl-intro">Facturación, contratos y procesos de tu negocio, más claros y fáciles de manejar.</p>
      <div class="fl-hero-actions"><a class="fl-button fl-button-primary" href="#productos">CONOCE LO QUE HACEMOS <span aria-hidden="true">↗</span></a><a class="fl-text-link" href="#contacto">Cuéntanos qué necesitas <span aria-hidden="true">↗</span></a></div>
      <p class="fl-micro">PRODUCTOS PROPIOS Y DESARROLLO A MEDIDA.</p>
    </section>

    <section class="fl-board-wrap" aria-label="Las soluciones de Clainev">
      <div class="fl-board-top"><span><i></i> Clainev / en una mirada</span><span>01 — 03</span></div>
      <div class="fl-board">
        <div class="fl-grid" aria-hidden="true"></div>
        <article class="fl-note fl-note-one"><span>01 / FACTURACIÓN</span><h2>Emite desde tu sistema.</h2><p>Emitiva conecta tu operación con la facturación electrónica SUNAT mediante una API.</p><b class="fl-note-arrow" aria-hidden="true">↗</b></article>
        <article class="fl-note fl-note-two"><span>02 / CONTRATOS</span><h2>Firma con más contexto.</h2><p>Firma Segura te ayuda a identificar cláusulas que merecen una segunda mirada.</p><b class="fl-note-arrow" aria-hidden="true">↗</b></article>
        <article class="fl-note fl-note-three"><span>03 / A MEDIDA</span><h2>Ordena tu operación.</h2><p>Construimos herramientas para los procesos particulares de tu negocio.</p><b class="fl-note-arrow" aria-hidden="true">↗</b></article>
        <div class="fl-board-scribble" aria-hidden="true">una solución<br/>para cada reto <span>↙</span></div>
      </div>
      <div class="fl-board-bottom"><span>● PRODUCTOS</span><span>↗ SOLUCIONES</span><span>✳ HECHO EN PERÚ</span></div>
      <p class="fl-caption">Tres formas de quitarle fricción a tu día a día.</p>
    </section>

    <section id="productos" class="fl-section fl-products">
      <header class="fl-section-heading"><span class="fl-pixel fl-pixel-orange" aria-hidden="true"></span><p class="fl-kicker">LO QUE HACEMOS</p><h2>Herramientas para <strong>avanzar.</strong></h2><p>Soluciones enfocadas en tareas concretas de negocios peruanos.</p></header>
      <div class="fl-product-grid">
        <article class="fl-product fl-product-emitiva"><div class="fl-product-meta"><span>01 / PRODUCTO</span><span>API</span></div><div class="fl-product-main"><div class="fl-product-symbol" aria-hidden="true">E<span>↗</span></div><h3>Emitiva</h3><p>Facturación electrónica desde el sistema que ya usas.</p></div><div class="fl-product-detail"><span>FACTURAS</span><span>BOLETAS</span><span>NOTAS</span></div><a href="#contacto" aria-label="Consultar sobre Emitiva">Conversemos sobre Emitiva <span aria-hidden="true">↗</span></a></article>
        <article class="fl-product fl-product-firma"><div class="fl-product-meta"><span>02 / PRODUCTO</span><span>CONTRATOS</span></div><div class="fl-product-main"><div class="fl-product-symbol" aria-hidden="true">F<span>✳</span></div><h3>Firma Segura</h3><p>Una lectura más clara de los puntos importantes antes de firmar.</p></div><div class="fl-contract-lines" aria-hidden="true"><i></i><i></i><i></i><span>● REVISAR</span></div><a href="#contacto" aria-label="Consultar sobre Firma Segura">Conversemos sobre Firma Segura <span aria-hidden="true">↗</span></a></article>
      </div>
    </section>

    <section id="servicios" class="fl-section fl-service">
      <header class="fl-section-heading"><span class="fl-pixel fl-pixel-pink" aria-hidden="true"></span><p class="fl-kicker">DESARROLLO A MEDIDA</p><h2>Tu forma de trabajar merece <strong>su propio espacio.</strong></h2><p>Si una herramienta estándar no encaja, diseñamos software para tu proceso.</p></header>
      <div class="fl-service-board"><div class="fl-service-card fl-service-card-a"><span>01 / OPERACIÓN</span><strong>Pedidos e inventario</strong><p>Información ordenada para tomar mejores decisiones.</p></div><div class="fl-service-card fl-service-card-b"><span>02 / CONEXIÓN</span><strong>Integraciones</strong><p>Menos pasos manuales entre las herramientas que usas.</p></div><div class="fl-service-card fl-service-card-c"><span>03 / FLUJO</span><strong>Automatizaciones</strong><p>Procesos repetitivos que pueden funcionar con menos esfuerzo.</p></div><div class="fl-service-doodle" aria-hidden="true">de la idea<br/>al uso real <span>↗</span></div></div>
      <a class="fl-button fl-button-dark" href="#contacto">HABLEMOS DE TU PROYECTO <span aria-hidden="true">↗</span></a>
    </section>

    <section class="fl-section fl-journal"><header class="fl-section-heading"><span class="fl-pixel fl-pixel-blue" aria-hidden="true"></span><p class="fl-kicker">DESDE EL TALLER</p><h2>Ideas que <strong>puedes usar.</strong></h2><p>Lecturas breves sobre facturación, contratos y software.</p></header><div class="fl-articles">{posts.map((post, index) => <a href={`/blog/${post.id}/`} class="fl-article"><span>{String(index + 1).padStart(2, "0")}</span><div><small>{post.data.category}</small><h3>{post.data.title}</h3></div><b aria-hidden="true">↗</b></a>)}</div><a class="fl-text-link" href="/blog">Ver todos los artículos <span aria-hidden="true">↗</span></a></section>

    <section id="contacto" class="fl-section fl-contact"><span class="fl-pixel fl-pixel-orange" aria-hidden="true"></span><p class="fl-kicker">HABLEMOS</p><h2>¿Qué necesita resolver <strong>tu negocio?</strong></h2><p>Cuéntanos si buscas un producto o una solución a medida. Empecemos por entender el problema.</p><a class="fl-button fl-button-primary" href="mailto:hola@clainev.com?subject=Consulta%20desde%20Clainev">ESCRÍBENOS POR CORREO <span aria-hidden="true">↗</span></a><span class="fl-contact-email">hola@clainev.com</span></section>
  </main>
</Layout>
